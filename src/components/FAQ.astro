---
const faqs = [
  {
    question: "What technologies do you work with most?",
    answer: "I primarily work with .NET/C#, TypeScript, Astro, and SQL. I also use Python for scripting and smaller automation tasks."
  },
  {
    question: "Are you available for freelance or internship opportunities?",
    answer: "Yes. I am open to software engineering internships, freelance development work, and collaborative projects that align with my skills."
  },
  {
    question: "Can I view source code for your projects?",
    answer: "Yes. Many projects include source links in the portfolio section, and my public repositories are available on GitHub."
  },
  {
    question: "What is the best way to contact you?",
    answer: "Email is the fastest way to reach me for opportunities or technical discussions. You can also connect through LinkedIn."
  },
  {
    question: "Do you publish technical notes or write-ups?",
    answer: "Yes. I use the Notes and Blog sections to capture what I am learning, document experiments, and share implementation details from projects."
  }
];
---

<section class="border-t border-slate-700/70 py-24 md:py-32">
  <div class="mx-auto max-w-3xl px-5">
    <div class="mb-16 reveal-on-scroll">
      <p class="mb-4 text-sm font-medium text-primary-400">FAQ</p>
      <h2 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl">Frequently Asked Questions</h2>
      <p class="text-lg leading-8 text-slate-400">
        Quick answers about my portfolio, work, and availability.
      </p>
    </div>

    <div class="border-y border-slate-700/70">
      {faqs.map((faq, index) => (
        <details class="group border-b border-slate-700/70 last:border-b-0 [&_summary::-webkit-details-marker]:hidden reveal-on-scroll" style={`transition-delay: ${index * 50}ms;`}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 py-6 text-white">
            <h3 class="font-heading text-lg font-bold">{faq.question}</h3>
            <span class="relative h-5 w-5 shrink-0 text-slate-500 transition-colors group-open:text-primary-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
              </svg>
            </span>
          </summary>
          <div class="pb-6 pr-10 leading-7 text-slate-400">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
