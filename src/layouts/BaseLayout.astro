---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/space-grotesk/index.css';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SOCIAL_LINKS } from '../config';
import { resolvePath } from '../utils/navigation';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/preview.png',
  type = 'website',
  publishedDate,
  modifiedDate,
  author,
} = Astro.props;

const siteURL = SITE_URL.endsWith('/') ? SITE_URL : `${SITE_URL}/`;
const canonicalBase = Astro.site?.href ?? siteURL;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, canonicalBase).href;
const imageURL = new URL(image, siteURL).href;
const fullTitle = `${title} | ${SITE_TITLE}`;
const robotsContent = 'index, follow';
const twitterHandleMatch = SOCIAL_LINKS.twitter.match(/(?:twitter\.com|x\.com)\/([A-Za-z0-9_]+)/i);
const twitterHandle = twitterHandleMatch ? `@${twitterHandleMatch[1]}` : undefined;
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: imageURL,
        url: canonicalURL,
        datePublished: publishedDate?.toISOString(),
        dateModified: (modifiedDate ?? publishedDate)?.toISOString(),
        author: author
          ? {
              '@type': 'Person',
              name: author,
            }
          : undefined,
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          logo: {
            '@type': 'ImageObject',
            url: new URL('/favicon.svg', siteURL).href,
          },
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description,
        url: siteURL,
      };
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={resolvePath('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={resolvePath('/sitemap.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {type === 'article' && (modifiedDate ?? publishedDate) && (
      <meta property="article:modified_time" content={(modifiedDate ?? publishedDate)?.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <title>{fullTitle}</title>

    <ClientRouter />

  </head>
  <body class="flex min-h-screen flex-col bg-[#0e141b] text-slate-200">
    <CommandPalette />
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Global Intersection Observer for Scroll Animations -->
    <script>
      const w: any = window;

      function syncHeaderOffset() {
        const header = document.getElementById('site-header');
        if (!header) return;

        const offset = Math.ceil(header.getBoundingClientRect().height) + 12;
        document.documentElement.style.setProperty('--header-offset', `${offset}px`);
      }

      function setupRevealObserver() {
        syncHeaderOffset();

        const rawOffset = getComputedStyle(document.documentElement).getPropertyValue('--header-offset').trim();
        const headerOffset = Number.parseInt(rawOffset, 10) || 100;

        if (w.__revealObserver) {
          w.__revealObserver.disconnect();
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            root: null,
            rootMargin: `-${headerOffset}px 0px -5% 0px`,
            threshold: 0.05,
          },
        );

        w.__revealObserver = observer;

        document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)').forEach((el) => {
          observer.observe(el);
        });
      }

      if (!w.__headerOffsetResizeBound) {
        w.__headerOffsetResizeBound = true;
        window.addEventListener('resize', syncHeaderOffset, { passive: true });
      }

      document.addEventListener('astro:page-load', () => {
        setupRevealObserver();
      });
    </script>
  </body>
</html>
