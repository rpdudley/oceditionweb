---
import Button from './Button.astro';
import { NAV_LINKS, BRAND_NAME, BRAND_LOGO_TEXT } from '../config';
import { resolvePath } from '../utils/navigation';
---

<header class="sticky top-0 z-[90] w-full transition-colors duration-300 glass-panel border-x-0 border-t-0 rounded-none shadow-sm pointer-events-auto">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-6">
    <a href={resolvePath('/')} class="flex items-center gap-3" aria-label={`${BRAND_NAME} home`}>
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-600 font-heading text-lg font-bold text-white">{BRAND_LOGO_TEXT}</span>
      <span class="font-heading text-xl font-bold text-white">{BRAND_NAME}</span>
    </a>

    <nav class="hidden md:block" aria-label="Main navigation">
      <ul class="flex items-center gap-2">
        {NAV_LINKS.map(link => (
          <li>
            <a href={resolvePath(link.href)} class="relative block p-2 text-sm font-medium text-slate-400 transition-colors after:absolute after:bottom-0 after:left-1/2 after:h-1 after:w-1 after:-translate-x-1/2 after:rounded-full after:bg-primary-400 after:opacity-0 after:transition-opacity hover:text-white hover:after:opacity-100">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <button onclick="window.toggleCommandPalette()" type="button" class="rounded-full p-2 text-slate-400 transition-colors hover:bg-white/5 hover:text-white" aria-label="Search" title="Search">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
      </button>
      <a href={resolvePath('/login/')} class="text-sm font-medium text-slate-400 transition-colors hover:text-white">Sign in</a>
      <Button href={resolvePath('/signup/')} variant="primary" size="sm">Get Started</Button>
    </div>

    <div class="flex items-center gap-1 md:hidden">
      <button onclick="window.toggleCommandPalette()" type="button" class="rounded-full p-2 text-slate-400 transition-colors hover:bg-white/5 hover:text-white" aria-label="Search" title="Search">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
      </button>
      <button id="mobile-menu-btn" type="button" class="rounded-full p-2 text-slate-400 transition-colors hover:bg-white/5 hover:text-white" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open main menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-700/70 bg-[#0e141b] md:hidden">
    <div class="mx-auto max-w-5xl space-y-1 px-5 py-4">
      {NAV_LINKS.map(link => (
        <a href={resolvePath(link.href)} class="block px-2 py-3 text-base font-medium text-slate-400 transition-colors hover:text-white">
          {link.label}
        </a>
      ))}
      <div class="mt-3 flex items-center justify-between border-t border-slate-700/70 pt-4">
        <a href={resolvePath('/login/')} class="px-2 py-2 text-sm font-medium text-slate-400 transition-colors hover:text-white">Sign in</a>
        <Button href={resolvePath('/signup/')} variant="primary" size="sm">Get Started</Button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
      const newBtn = mobileMenuBtn.cloneNode(true) as HTMLButtonElement;
      mobileMenuBtn.parentNode?.replaceChild(newBtn, mobileMenuBtn);
      
      newBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        newBtn.setAttribute('aria-expanded', String(!mobileMenu.classList.contains('hidden')));
      });
    }
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', () => {
    setupMobileMenu();
  });
</script>
